rules_version = '2';

// SkyGuide profiles. Each signed-in user can read and write only their own
// document at users/{uid}. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(d) {
      return d.keys().hasOnly(['displayName', 'avatar', 'favourites', 'settings', 'home', 'createdAt', 'updatedAt'])
        && (!('displayName' in d) || (d.displayName is string && d.displayName.size() <= 40))
        && (!('avatar' in d) || (d.avatar is string && d.avatar.size() <= 20))
        && (!('favourites' in d) || (d.favourites is list && d.favourites.size() <= 300))
        && (!('settings' in d) || d.settings is map)
        && (!('home' in d) || d.home == null || (d.home is map
              && d.home.lat is number && d.home.lat >= -90 && d.home.lat <= 90
              && d.home.lon is number && d.home.lon >= -180 && d.home.lon <= 180));
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProfile(request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
